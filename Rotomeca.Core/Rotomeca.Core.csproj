<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>Rotomeca.Core</PackageId>
    <Version>1.0.0</Version>
    <Description>Méta-package Rotomeca.Core, il regroupe Collections et Optionals.</Description>
    <Authors>Rotomeca</Authors>
    <Copyright>© Rotomeca</Copyright>
    <PackageProjectUrl>https://github.com/rotomeca-libs/core-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rotomeca-libs/core-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>ISC</PackageLicenseExpression>
    <PackageTags>
      rotomeca;core;collections;optional;maybe;rarray;
      functional;fluent;array;javascript;
      netstandard;dotnet;csharp
    </PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="assets/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rotomeca.Core.Collections" Version="1.0.0" />
    <PackageReference Include="Rotomeca.Core.Optionals" Version="1.0.1" />
  </ItemGroup>

</Project>